# ─────────────────────────────────────────────────────────────────────────────
#  Netlifegy Mail Server — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core Flask ────────────────────────────────────────────────────────────────
# Long random secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/netlifegy

# SQLite fallback (development only — remove DATABASE_URL above to use)
# DATABASE_URL=sqlite:///emailserver.db

# ── SMTP (Outgoing Mail) ──────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
DEFAULT_SENDER=noreply@netlifegy.com

# ── IMAP (Incoming Mail) ──────────────────────────────────────────────────────
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# ── Organisation ─────────────────────────────────────────────────────────────
# All user accounts are created as username@ORG_DOMAIN
ORG_DOMAIN=netlifegy.com
ORG_NAME=Netlifegy

# ── Email Verification & Password Reset ───────────────────────────────────────
# Public base URL (used to build links in emails)
BASE_URL=https://netlifegy.com
# SMTP for identity/system emails (can be same as above)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@netlifegy.com

# ── Security ──────────────────────────────────────────────────────────────────
# Maximum failed logins before IP ban
MAX_LOGIN_ATTEMPTS=5
# How long (minutes) a temporary ban lasts
BAN_DURATION_MINUTES=60
# Session timeout in minutes (0 = never)
SESSION_TIMEOUT=0

# ── PWA / Android App ────────────────────────────────────────────────────────
# URL embedded in the Android WebView app (update before building APK)
APP_URL=https://netlifegy.com

# ── Optional: Flask Debug Mode ────────────────────────────────────────────────
# Set to true only in development — NEVER in production
FLASK_DEBUG=false
